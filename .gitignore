# macOS
.DS_Store

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Local deploy scripts — they contain your GitHub token. NEVER publish them.
*.command

# Local Finder shortcut to the live site — not part of the deployable page.
*.webloc

# Reference images / screenshots dropped in the folder — never part of
# the deployable page (El Recreo is a single self-contained index.html).
*.png
*.jpg
*.jpeg

# Local reference / design source — NOT part of the deployable page.
_reference/
_archive/

# Exception: the home-screen / favicon app icons ARE part of the deployable
# site (referenced from index.html and site.webmanifest). Keep them tracked.
!apple-touch-icon.png
!favicon-16.png
!favicon-32.png
!icon-192.png
!icon-512.png
!icon-512-maskable.png
