# macOS
.DS_Store

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Local deploy scripts — they contain your GitHub token. NEVER publish them.
*.command

# Local Finder shortcut to the live site — not part of the deployable page.
*.webloc

# Reference images / screenshots dropped in the folder — never part of
# the deployable page (El Recreo is a single self-contained index.html).
*.png
*.jpg
*.jpeg

# Local reference / design source — NOT part of the deployable page.
_reference/
_archive/

# Hero lockup images — part of the deployable site.
!lockup-light.png
!lockup-dark.png

# Mockup assets — part of the deployable /mockups/ preview.
!mockups/ristre-scene.jpg
!mockups/ristre-close.jpg
!mockups/ristre-hero.jpg
!mockups/ristre-face.jpg
